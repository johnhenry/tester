{
  "name": "@johnhenry/tester",
  "version": "0.0.0",
  "description": "A context-independent, zero-dependency TAP testing framework inspired by tape. Runs unchanged in Node, Deno, and the browser.",
  "main": "./index.mjs",
  "homepage": "https://opensource.johnhenry.me/tester/",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.mjs",
    "./TAPRunner": "./TAPRunner.mjs",
    "./assertions": "./assertions/index.mjs",
    "./unique": "./unique/index.mjs",
    "./testerror": "./testerror.mjs"
  },
  "files": [
    "index.mjs",
    "TAPRunner.mjs",
    "assertions",
    "unique",
    "testerror.mjs"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node tester.test.mjs",
    "examples": "for f in examples/*.mjs; do echo \"== $f\"; node \"$f\" || exit 1; done"
  },
  "keywords": [
    "test",
    "testing",
    "tape",
    "TAP",
    "assertions",
    "zero-dependency"
  ],
  "author": "John Henry",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/tester.git"
  }
}
